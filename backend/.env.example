# Copie para backend/.env. Nunca commite o .env real.

PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/bikeger
# Atlas: MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/bikeger?retryWrites=true&w=majority

# Obrigatório em produção no Render (JWT forte). FRONTEND_URL e API_PUBLIC_URL
# têm padrão no código: https://bikeger.vercel.app e https://bikeger.onrender.com.
JWT_SECRET=troque-por-uma-chave-longa-aleatoria
FRONTEND_URL=http://localhost:5174
API_PUBLIC_URL=http://localhost:4000

# Mercado Pago — o webhook morre sem API_PUBLIC_URL + MP_WEBHOOK_SECRET.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# NFC-e Focus. Opcional. Sem token / fiscal desligado em Ajustes a loja opera só com cupom térmico.
FOCUS_NFE_TOKEN=
# Em produção o CSC da SEFAZ também fica só no .env (não no Mongo).
FISCAL_CSC_ID=
FISCAL_CSC_TOKEN=

# WhatsApp Cloud (opcional). Em produção o token também fica só no .env.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Backup no fechamento também em desenvolvimento (em produção já roda).
# BACKUP_ON_CLOSE=true
# BACKUP_DIR=
# Cópia extra do .json.gz (PUT). Use {filename} na URL se o destino precisar do nome.
# BACKUP_CLOUD_PUT_URL=
# BACKUP_CLOUD_PUT_TOKEN=

# Só desenvolvimento: cria dono/balcao/mecanico com senha bikeger.
ALLOW_DEMO_USERS=true

STORE_NAME=BikeGer
STORE_PHONE=
STORE_ADDRESS=
STORE_CNPJ=
